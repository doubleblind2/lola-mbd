def ASSUMPTION: Bool =
(!c5 -> (g5 == g10[-1,false])) &&
(!c6 -> (g6 == g11[-1,false])) &&
(!c7 -> (g7 == g13[-1,false])) &&
(!c14 -> (g14 == !g0)) &&
(!c17 -> (g17 == !g11)) &&
