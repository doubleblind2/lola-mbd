(!c9 -> (g9 == !(g16 && g15))) &&
(!c10 -> (g10 == !(g14 || g11))) &&
(!c10 -> (g11 == !(g5 || g9))) &&
(!c12 -> (g12 == !(g1 || g7))) &&
(!c13 -> (g13 == !(g2 || g12)));
