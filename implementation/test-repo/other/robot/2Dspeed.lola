in speed: Real;
in nextDirX: Real;
in nextDirY: Real;

def x: Real;
def y: Real;
def dx: Real;
def dy: Real;
dx = nextDirX[-1,1] * speed;
dy = nextDirY[-1,0] * speed;
x = x[-1,0] + dx;
y = y[-1,0] + dy;

def col: Bool;
#def Fcol: Bool;
col = (x > 10) && (y > 10);
#Fcol = col || Fcol[1,false];

def validSpeed: Real;
validSpeed = speed[1,0];

out x;
out y;
out col;
out validSpeed;


# Assumptions

def maxVelocity: Bool;
maxVelocity = (dx <= 3) && (dx >= -3) && (dy <= 3) && (dy >= -3);

#def maxChange: Bool;
#maxChange = ((dx - dx[-1,0]) <= 1) && ((dx - dx[-1,0]) >= -1) && ((dy - dy[-1,0]) <= 1) && ((dy - dy[-1,0]) >= -1);

def bounds: Bool;
bounds = (x >= -20) && (x <= 20) && (y >= -20) && (y <= 20);

def ASSUMPTION: Bool;
ASSUMPTION = maxVelocity && (!col) && bounds;
