in dx: Real;

def x: Real;
x = x[-1,0] + dx;

def col: Bool;
#def Fcol: Bool;
col = x >= 100;
#Fcol = col || Fcol[1,false];

def validDx: Real;
validDx = dx[1,0];

out x;
out col;
out validDx;


# Assumption

def maxVelocity: Bool;
maxVelocity = (dx > -5) && (dx < 5);

def maxChange: Bool;
maxChange = ((dx - dx[-1,0]) < 1) && ((dx - dx[-1,0]) > -1);

def ASSUMPTION: Bool;
ASSUMPTION = maxVelocity && maxChange && (!col);
