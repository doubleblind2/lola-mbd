in l : Real;
in r : Real;
in d: Real;

in lw: Real;

def crash: Bool;
crash = (d < 1) && (((l <= 1) && (-1 <= l)) || ((r <= 1) && (-1 <= r)) || ((l <= -1) && (r >= 1)));

def fcrash: Bool;
fcrash = crash || fcrash[1,false];

def ld : Real;
ld = (l - l[-1,0]);
def rd : Real;
rd = (r - r[-1,0]);
def dd: Real;
dd = (d[-1,10000] - d);

def nearing: Bool;
nearing = (ld == (0.6 * lw)) && (rd == (0.6 * lw)) && (dd >= 1);

def gnearing: Bool;
gnearing = nearing && gnearing[1,true];

def ASSUMPTION: Bool;
ASSUMPTION = (lw <= 3) && (lw >= -3) && (l <= r) && ((r - l) <= 6) && (r < 15) && (l > -15);



# def nextLW: Real;
# nextLW = lw[1,0];

# out nextLW;

# Query nextLW under gnearing, !fcrash

def l3 : Bool;
l3 = gnearing[1,true] && (!fcrash) && (lw[1,0] == 3);
out l3;

def l2 : Bool;
l2 = gnearing[1,true] && (!fcrash) && (lw[1,0] == 2);
out l2;

def l1 : Bool;
l1 = gnearing[1,true] && (!fcrash) && (lw[1,0] == 1);
out l1;

def l0 : Bool;
l0 = gnearing[1,true] && (!fcrash) && (lw[1,0] == 0);
out l0;

def lM1 : Bool;
lM1 = gnearing[1,true] && (!fcrash) && (lw[1,0] == -1);
out lM1;

def lM2 : Bool;
lM2 = gnearing[1,true] && (!fcrash) && (lw[1,0] == -2);
out lM2;

def lM3 : Bool;
lM3 = gnearing[1,true] && (!fcrash) && (lw[1,0] == -3);
out lM3;

out nearing;
