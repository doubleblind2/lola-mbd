
in r0: Bool;
in r1: Bool;
in r2: Bool;
in r3: Bool;
in r4: Bool;

in stairs: Bool;
in doors: Bool;
in e: Real;

def oneRoom: Bool;
oneRoom = (r0 || r1 || r2 || r3 || r4) && (r0 -> ((!r1) && (!r2) && (!r3) && (!r4))) && (r1 -> ((!r0) && (!r2) && (!r3) && (!r4))) && (r2 -> ((!r0) && (!r1) && (!r3) && (!r4))) && (r3 -> ((!r0) && (!r1) && (!r2) && (!r4))) && (r4 -> ((!r0) && (!r1) && (!r2) && (!r3)));

def transitions: Bool;
transitions = (r0 -> (r0[1, true] || r1[1, true])) && (r1 -> (r0[1, true] || r1[1, true] || r2[1, true] || r4[1, true])) && (r2 -> (r1[1, true] || r2[1, true] || r3[1, true] || r4[1, true])) && (r3 -> (r2[1, true] || r3[1, true])) && (r4 -> (r1[1, true] || r2[1, true] || r4[1, true]));

def stairLogic: Bool;
stairLogic = ((r1[-1, false] && r2) || (r2[-1, false] && r1) || (r2[-1, false] && r4) || (r4[-1, false] && r2)) <-> stairs;

def energyLogic: Bool;
energyLogic = (stairs -> ((e[-1, 1000] - e) >= 10)) && ((!stairs) -> ((e[-1, 1000] - e) >= 5));

def doorLogic: Bool;
doorLogic = ((r1 && r4[1, true]) || (r4 && r1[1, true]) || (r2 && r4[1, true]) || (r4 && r2[1, true])) -> doors;

def ASSUMPTION: Bool;
ASSUMPTION = oneRoom && transitions && stairLogic && energyLogic && doorLogic;

def critical: Bool;
critical = (e < 10) && (!r0) && (!r4);

def Fcritical: Bool;
Fcritical = critical || Fcritical[1, false];

def r0A: Bool;
def r1A: Bool;
def r2A: Bool;
def r3A: Bool;
def r4A: Bool;
r0A = r0[1, false] -> Fcritical;
r1A = r1[1, false] -> Fcritical;
r2A = r2[1, false] -> Fcritical;
r3A = r3[1, false] -> Fcritical;
r4A = r4[1, false] -> Fcritical;

out Fcritical;
out critical;
out r0A;
out r1A;
out r2A;
out r3A;
out r4A;
out e;

def o0: Bool;
def o1: Bool;
def o2: Bool;
def o3: Bool;
def o4: Bool;
def oStairs: Bool;
def oDoors: Bool;

o0 = r0;
o1 = r1;
o2 = r2;
o3 = r3;
o4 = r4;
oStairs = stairs;
oDoors = doors;

out o0;
out o1;
out o2;
out o3;
out o4;
out oStairs;
out oDoors;